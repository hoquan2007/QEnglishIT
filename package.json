{
  "name": "qenglishit",
  "version": "0.1.0",
  "private": true,
  "description": "QEnglishIT — Nền tảng luyện thi TOEIC miễn phí",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "content:validate": "node scripts/validate/validate-content.mjs",
    "content:qa": "node --env-file-if-exists=.env.local scripts/qa/report.mjs",
    "content:test": "node --test scripts/validate/*.test.mjs scripts/qa/*.test.mjs scripts/audio/*.test.mjs scripts/bank-tests.test.mjs",
    "vocab:build": "node scripts/vocab/build-wordlist.mjs",
    "vocab:ipa": "node scripts/vocab/enrich-ipa.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.2.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
