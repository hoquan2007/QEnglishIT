      "questions": [
        {
          "number": 1,
          "part": 5,
          "question_type": "mcq",
          "question_text": "The board will approve the revised budget ------- the external auditor raises a material objection.",
          "options": [
            {
              "key": "A",
              "text": "despite"
            },
            {
              "key": "B",
              "text": "whereas"
            },
            {
              "key": "C",
              "text": "because of"
            },
            {
              "key": "D",
              "text": "unless"
            }
          ],
          "correct_answer": "D",
          "translation": "Hội đồng sẽ phê duyệt ngân sách sửa đổi trừ khi kiểm toán viên bên ngoài đưa ra phản đối đáng kể. Các lựa chọn: (A) bất chấp; (B) trong khi (đối lập); (C) bởi vì (đi với danh từ); (D) trừ khi.",
          "explanation": "Unless tạo ngoại lệ cho quyết định phê duyệt. Despite và because of không trực tiếp nối mệnh đề có động từ raises.",
          "difficulty": 4,
          "tags": [
            "conjunction"
          ],
          "skill_tags": [
            "conjunction"
          ],
          "source": "original",
          "independent_review": "pending"
        }
      ]
    },
