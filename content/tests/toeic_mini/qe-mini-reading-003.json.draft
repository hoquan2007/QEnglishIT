      "questions": [
        {
          "number": 3,
          "part": 5,
          "question_type": "mcq",
          "question_text": "The event’s carbon footprint was ------- lower after the organizers switched to local suppliers.",
          "options": [
            {
              "key": "A",
              "text": "substantial"
            },
            {
              "key": "B",
              "text": "substance"
            },
            {
              "key": "C",
              "text": "substantiate"
            },
            {
              "key": "D",
              "text": "substantially"
            }
          ],
          "correct_answer": "D",
          "translation": "Dấu chân carbon của sự kiện đã thấp hơn đáng kể sau khi ban tổ chức chuyển sang nhà cung cấp địa phương. Các lựa chọn: (A) đáng kể (tính từ); (B) chất liệu/bản chất; (C) chứng minh; (D) đáng kể.",
          "explanation": "Lower là tính từ so sánh, cần trạng từ chỉ mức độ substantially bổ nghĩa.",
          "difficulty": 4,
          "tags": [
            "word-form"
          ],
          "skill_tags": [
